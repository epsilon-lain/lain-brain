{
  "name": "lain-brain",
  "version": "0.1.0",
  "description": "An AI-assisted personal knowledge modeling plugin.",
  "license": "MIT",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:parent-selector": "node tests/create-candidate-note-modal.test.mjs",
    "test:parent-persistence": "node tests/candidate-parent-persistence.test.mjs",
    "test": "npm run test:parent-selector && npm run test:parent-persistence && npm run test:name-cleanup && npm run test:broken-links && npm run test:vision && npm run test:naming",
    "test:vision": "node tests/openai-vision.test.mjs",
    "test:naming": "node tests/personal-naming.test.mjs",
    "test:name-cleanup": "node tests/note-name-cleanup.test.mjs",
    "test:broken-links": "node tests/broken-link-cleanup.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
